{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "grapheway": ["./packages/core/src/index.ts"],
      "@grapheway/web": ["./packages/web/src/index.ts"],
      "@grapheway/compat": ["./packages/compat/src/index.ts"],
      "@grapheway/agent": ["./packages/agent/src/index.ts"],
      "@grapheway/probe": ["./packages/probe/src/index.ts"]
    },
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/skill/**/*.ts",
    "examples/**/*.ts"
  ]
}
