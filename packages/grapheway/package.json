{
  "name": "grapheway",
  "version": "0.2.7",
  "description": "Open protocol for AI agents to discover, traverse, and act on website content as a live knowledge graph \u2014 no scraping, no fees. `npx grapheway init` mounts the surface; subpath exports: grapheway/web, grapheway/probe, grapheway/agent, grapheway/compat, grapheway/cli.",
  "type": "module",
  "private": false,
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./web": {
      "import": "./dist/web/index.js",
      "types": "./dist/web/index.d.ts"
    },
    "./probe": {
      "import": "./dist/probe/index.js",
      "types": "./dist/probe/index.d.ts"
    },
    "./agent": {
      "import": "./dist/agent/index.js",
      "types": "./dist/agent/index.d.ts"
    },
    "./compat": {
      "import": "./dist/compat/index.js",
      "types": "./dist/compat/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/cli.js",
      "types": "./dist/cli/cli.d.ts"
    }
  },
  "bin": {
    "grapheway": "dist/cli/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SKILL.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-unified.mjs",
    "test": "bun test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "mcp-server",
    "knowledge-graph",
    "llm",
    "chatgpt",
    "claude",
    "crawler",
    "web scraping",
    "agent-ready",
    "agent-experience",
    "ax",
    "a2a",
    "agent-skills",
    "llms-txt",
    "geo",
    "seo",
    "agent-protocol",
    "edge"
  ],
  "author": "Operivora",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6yte96/grapheway.git",
    "directory": "packages/grapheway"
  },
  "homepage": "https://6yte96.github.io/grapheway/",
  "bugs": {
    "url": "https://github.com/6yte96/grapheway/issues"
  },
  "mcpName": "io.github.6yte96/grapheway"
}
