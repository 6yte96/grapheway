{
  "name": "@grapheway/compat",
  "version": "0.1.0",
  "description": "Optional legacy agent-discovery files (llms.txt, agents.txt, robots.txt, sitemap.xml) for grapheway. Fully decoupled from the runtime core — mount it only if you want these.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "agent",
    "llms.txt",
    "agents.txt",
    "robots.txt",
    "sitemap",
    "geo"
  ],
  "license": "GPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.0"
  },
  "dependencies": {
    "grapheway": "0.1.0"
  },
  "scripts": {
    "test": "bun test",
    "prepublishOnly": "bun ../../scripts/build.mjs"
  }
}
