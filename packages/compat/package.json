{
  "name": "@grapheway/compat",
  "version": "0.1.0",
  "description": "Optional legacy agent-discovery files (llms.txt, agents.txt, robots.txt, sitemap.xml) for grapheway. Fully decoupled from the runtime core — mount it only if you want these.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src"],
  "keywords": ["agent", "llms.txt", "agents.txt", "robots.txt", "sitemap", "geo"],
  "license": "GPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.0"
  },
  "dependencies": {
    "grapheway": "workspace:*"
  },
  "scripts": {
    "test": "bun test"
  }
}
