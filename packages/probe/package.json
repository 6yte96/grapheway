{
  "name": "@grapheway/probe",
  "version": "0.1.0",
  "description": "Convert any legacy website into a live agent-native knowledge graph — no site involvement, no paid crawlers. Probe a URL, get a graph agents can walk, search and act on, served locally or exported as JSON.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "agent",
    "crawler",
    "knowledge-graph",
    "mcp",
    "docs",
    "llm",
    "ai",
    "native-access"
  ],
  "license": "GPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.0"
  },
  "dependencies": {
    "grapheway": "workspace:*",
    "@grapheway/web": "workspace:*",
    "@types/node": "^22.10.0"
  },
  "scripts": {
    "test": "bun test",
    "prepublishOnly": "bun ../../scripts/build.mjs"
  }
}
