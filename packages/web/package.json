{
  "name": "@grapheway/web",
  "version": "0.1.0",
  "description": "Drop-in runtime agent endpoint for any Node web app: knowledge graph (/graph/v1), discovery (/.well-known/agent), actions, open MCP (/mcp) + framework adapters.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "agent",
    "mcp",
    "llms.txt",
    "agents.txt",
    "api",
    "geo",
    "ai",
    "llm"
  ],
  "license": "GPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.0"
  },
  "dependencies": {
    "grapheway": "workspace:*",
    "@types/node": "^22.10.0"
  },
  "scripts": {
    "test": "bun test"
  }
}
