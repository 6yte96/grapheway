{
  "name": "@grapheway/agent",
  "version": "0.1.0",
  "description": "The agent-side of grapheway: a typed client for any grapheway-enabled site, a runnable stdio MCP server that turns any site's actions into MCP tools, and a SKILL.md for AI agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./skill/*": "./skill/*"
  },
  "bin": {
    "grapheway-mcp": "./dist/mcp-stdio.js"
  },
  "files": [
    "dist",
    "src",
    "skill"
  ],
  "keywords": [
    "agent",
    "mcp",
    "llms.txt",
    "agents.txt",
    "client",
    "ai",
    "llm",
    "skill"
  ],
  "license": "GPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.0"
  },
  "scripts": {
    "test": "bun test"
  },
  "devDependencies": {
    "@grapheway/web": "0.1.0",
    "@grapheway/compat": "0.1.0",
    "grapheway": "0.1.0"
  }
}
