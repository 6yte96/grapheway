{
  "name": "@grapheway/agent",
  "version": "0.1.0",
  "description": "The agent-side of grapheway: a typed client for any grapheway endpoint (site runtime or gateway) plus a SKILL.md that teaches agents to use graph endpoints before scraping.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./skill/*": "./skill/*"
  },
  "files": [
    "dist",
    "src",
    "skill"
  ],
  "keywords": [
    "agent",
    "mcp",
    "graph",
    "client",
    "ai",
    "llm",
    "skill"
  ],
  "license": "GPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.0"
  },
  "scripts": {
    "test": "bun test",
    "prepublishOnly": "bun ../../scripts/build.mjs"
  },
  "devDependencies": {
    "@grapheway/web": "0.1.0",
    "@grapheway/compat": "0.1.0",
    "grapheway": "0.1.0"
  }
}
