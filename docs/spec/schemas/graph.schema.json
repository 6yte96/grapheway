{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grapheway.dev/schemas/graph.json",
  "title": "Grapheway knowledge graph",
  "type": "object",
  "required": [
    "nodes",
    "edges"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "page",
              "section",
              "entity",
              "concept",
              "api"
            ]
          },
          "label": {
            "type": "string"
          },
          "props": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "links_to",
              "is_part_of",
              "related",
              "mentions",
              "exposes"
            ]
          },
          "label": {
            "type": "string"
          },
          "props": {
            "type": "object"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot": {
          "type": "boolean"
        }
      }
    }
  }
}
